NEXT_PUBLIC_APP_NAME="Firm Display"
DISPLAY_REFRESH_SECONDS=60
DATABASE_PATH="./data/kiosk.sqlite"

# Microsoft Graph app-only auth. Leave blank to use mock calendar data.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_GRAPH_SCOPE="https://graph.microsoft.com/.default"
# Optional display labels for calendar mailbox cards: "mailbox@firm.com|Last Name;other@firm.com|Last Name"
CALENDAR_DISPLAY_NAMES=""

# Privacy defaults for calendar cards.
CALENDAR_PRIVACY_SAFE=true

# Optional weather provider settings. MVP uses mock weather if blank.
WEATHER_PROVIDER="mock"
WEATHER_API_BASE_URL=""
WEATHER_LOCATION="Pittsburgh, PA"
# Optional multiple cards: "Pittsburgh Office|Pittsburgh, PA;Ebensburg Office|Ebensburg, PA;Arkansas Office|Russellville, AR;Mexico Office|Tepic, Nayarit, Mexico;South Africa Office|Krugersdorp, Gauteng, South Africa"
WEATHER_LOCATIONS="Pittsburgh Office|Pittsburgh, PA;Ebensburg Office|Ebensburg, PA;Arkansas Office|Russellville, AR;Mexico Office|Tepic, Nayarit, Mexico;South Africa Office|Krugersdorp, Gauteng, South Africa"
